<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:BloodPressureDiary.UI.Resources.Localization"
             xmlns:viewModels="clr-namespace:BloodPressureDiary.UI.ViewModels"
             xmlns:behaviors="clr-namespace:Kmaraszkiewicz86.Maui.Behaviors;assembly=Kmaraszkiewicz86.Maui.Behaviors"
             x:Class="BloodPressureDiary.UI.MainPage"
             Title="{x:Static localization:AppResources.BloodPressureMeasurementsTab}">
    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="{x:Static localization:AppResources.NewBloodPressureMeasurement}" FontSize="22" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Systolic}" />
                    <Entry Text="{Binding SystolicInput}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Diastolic}" />
                    <Entry Text="{Binding DiastolicInput}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Pulse}" />
                    <Entry Text="{Binding PulseInput}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Date}" />
                    <DatePicker Date="{Binding MeasuredDate}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Time}" />
                    <TimePicker Time="{Binding MeasuredTime}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Notes}" />
                    <Entry Text="{Binding NotesInput}" />
                </VerticalStackLayout>
            </Grid>
            <Button Text="{x:Static localization:AppResources.Save}" Command="{Binding SaveCommand}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="{x:Static localization:AppResources.ExportBackup}" Command="{Binding ExportBackupCommand}" />
                <Button Grid.Column="1" Text="{x:Static localization:AppResources.ExportReport}" Command="{Binding ExportReportCommand}" />
            </Grid>

            <Label Text="{x:Static localization:AppResources.BloodPressureMeasurements}" FontSize="22" FontAttributes="Bold" />
            <Label Text="{x:Static localization:AppResources.NoBloodPressureMeasurements}" IsVisible="{Binding IsEmpty}" />

            <CollectionView
                ItemsSource="{Binding BloodPressureMeasurements}"
                SelectionMode="None"
                VerticalOptions="Fill">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:BloodPressureMeasurementRowViewModel">

                        <Border
                            Margin="8,4"
                            Padding="12"
                            Stroke="{AppThemeBinding Light=#D6DCE4, Dark=#6E6E6E}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#303030}">

                            <VerticalStackLayout Spacing="12">

                                <!-- Date and time -->
                                <Label
                                    Text="{Binding DisplayDateTime, StringFormat='{0:dd-MM-yyyy HH:mm}'}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    IsVisible="{Binding IsNotEditing}" />

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8"
                                    IsVisible="{Binding IsEditing}">

                                    <DatePicker
                                        Grid.Column="0"
                                        Date="{Binding MeasuredDate}" />

                                    <TimePicker
                                        Grid.Column="1"
                                        Time="{Binding MeasuredTime}" />
                                </Grid>

                                <!-- Measurement values -->
                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8">

                                    <!-- Systolic -->
                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="4">

                                        <Label
                                            Text="{x:Static localization:AppResources.Systolic}"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center" />

                                        <Label
                                            Text="{Binding BloodPressureMeasurement.Systolic}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsNotEditing}" />

                                        <Entry
                                            Text="{Binding SystolicInput}"
                                            Keyboard="Numeric"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsEditing}" />
                                    </VerticalStackLayout>

                                    <!-- Diastolic -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4">

                                        <Label
                                            Text="{x:Static localization:AppResources.Diastolic}"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center" />

                                        <Label
                                            Text="{Binding BloodPressureMeasurement.Diastolic}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsNotEditing}" />

                                        <Entry
                                            Text="{Binding DiastolicInput}"
                                            Keyboard="Numeric"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsEditing}" />
                                    </VerticalStackLayout>

                                    <!-- Pulse -->
                                    <VerticalStackLayout
                                        Grid.Column="2"
                                        Spacing="4">

                                        <Label
                                            Text="{x:Static localization:AppResources.Pulse}"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center" />

                                        <Label
                                            Text="{Binding PulseDisplay}"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsNotEditing}" />

                                        <Entry
                                            Text="{Binding PulseInput}"
                                            Keyboard="Numeric"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsEditing}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Notes -->
                                <!-- Notes -->
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="{x:Static localization:AppResources.Notes}"
                                        FontSize="12"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding NotesDisplay}"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        IsVisible="{Binding IsNotEditing}" />

                                    <Entry
                                        Text="{Binding NotesInput}"
                                        IsVisible="{Binding IsEditing}" />
                                </VerticalStackLayout>

                                <Entry
                                    Text="{Binding NotesInput}"
                                    Placeholder="{x:Static localization:AppResources.Notes}"
                                    IsVisible="{Binding IsEditing}" />

                                <!-- Actions -->
                                <HorizontalStackLayout
                                    Spacing="8"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding IsNotEditing}">

                                    <Button
                                        Text="{x:Static localization:AppResources.Edit}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}" />

                                    <Button
                                        Text="{x:Static localization:AppResources.Delete}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
