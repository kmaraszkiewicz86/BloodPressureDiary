<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:BloodPressureDiary.UI.Resources.Localization"
             xmlns:viewModels="clr-namespace:BloodPressureDiary.UI.ViewModels"
             xmlns:views="clr-namespace:BloodPressureDiary.UI.Views"
             xmlns:behaviors="clr-namespace:Kmaraszkiewicz86.Maui.Behaviors;assembly=Kmaraszkiewicz86.Maui.Behaviors"
             x:Class="BloodPressureDiary.UI.MainPage"
             Title="{x:Static localization:AppResources.BloodPressureMeasurementsTab}">
    <ContentPage.Resources>
        <!-- Layout and headings for the measurements page. -->
        <Style x:Key="PageContentStyle" TargetType="VerticalStackLayout">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Spacing" Value="14" />
        </Style>
        <Style x:Key="FileActionsStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="10" />
            <Setter Property="RowSpacing" Value="8" />
        </Style>
        <Style x:Key="DateRangeStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="10" />
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="CenteredLabelStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="HistoryListStyle" TargetType="CollectionView">
            <Setter Property="VerticalOptions" Value="Fill" />
        </Style>

        <!-- Styles for each history item and its inline editor. -->
        <Style x:Key="HistoryItemStyle" TargetType="Border" BasedOn="{StaticResource DefaultBorderStyle}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#D6DCE4, Dark=#6E6E6E}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#303030}" />
        </Style>
        <Style x:Key="HistoryItemContentStyle" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style x:Key="HistoryDateStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="HistoryColumnsStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="8" />
        </Style>
        <Style x:Key="HistoryFieldStyle" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style x:Key="MeasurementCaptionStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="MeasurementValueStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="MeasurementEntryStyle" TargetType="Entry" BasedOn="{StaticResource DefaultEntryStyle}">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="NotesCaptionStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="NotesValueStyle" TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="HistoryActionsStyle" TargetType="HorizontalStackLayout">
            <Setter Property="Spacing" Value="8" />
            <Setter Property="HorizontalOptions" Value="End" />
        </Style>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContentStyle}">
                <!-- Open the form for a new measurement. -->
                <Button Text="{x:Static localization:AppResources.AddBloodPressureMeasurement}" Command="{Binding AddBloodPressureMeasurementCommand}" />

                <!-- Backup and report actions. -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Style="{StaticResource FileActionsStyle}">
                    <Button Grid.Column="0" Text="{x:Static localization:AppResources.ExportBackup}" Command="{Binding ExportBackupCommand}" />
                    <Button Grid.Column="1" Text="{x:Static localization:AppResources.ImportBackup}" Command="{Binding ImportBackupCommand}" />
                    <Button Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static localization:AppResources.ExportReport}" Command="{Binding ExportReportCommand}" />
                </Grid>

                <!-- History period and optional date range filters. -->
                <Label Text="{x:Static localization:AppResources.BloodPressureMeasurements}" Style="{StaticResource SectionHeadingStyle}" />
                <Picker x:Name="HistoryPicker"
                        Title="{x:Static localization:AppResources.HistoryFilter}"
                        ItemsSource="{Binding HistoryFilters}"
                        SelectedIndex="{Binding SelectedHistoryFilter}">
                    <Picker.Behaviors>
                        <behaviors:EventToCommandBehavior EventName="SelectedIndexChanged"
                                                           Command="{Binding FilterHistoryCommand}"
                                                           CommandParameter="{Binding Source={x:Reference HistoryPicker}, Path=SelectedIndex}" />
                    </Picker.Behaviors>
                </Picker>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{x:Static localization:AppResources.UseDateRange}" Style="{StaticResource CenteredLabelStyle}" />
                    <Switch Grid.Column="1" IsToggled="{Binding UseHistoryDateRange}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Style="{StaticResource DateRangeStyle}" IsVisible="{Binding UseHistoryDateRange}">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{x:Static localization:AppResources.StartDate}" />
                        <DatePicker Date="{Binding HistoryStartDate}" MaximumDate="{Binding Today}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="{x:Static localization:AppResources.EndDate}" />
                        <DatePicker Date="{Binding HistoryEndDate}" MaximumDate="{Binding Today}" />
                    </VerticalStackLayout>
                </Grid>
                <Button Text="{x:Static localization:AppResources.ApplyFilter}" Command="{Binding ApplyHistoryDateRangeCommand}" />
                <Label Text="{x:Static localization:AppResources.NoBloodPressureMeasurements}" IsVisible="{Binding IsEmpty}" />

                <!-- Saved measurements and inline editing. -->
                <CollectionView
                    ItemsSource="{Binding BloodPressureMeasurements}"
                    SelectionMode="None"
                    Style="{StaticResource HistoryListStyle}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:BloodPressureMeasurementRowViewModel">

                            <Border Style="{StaticResource HistoryItemStyle}">

                                <VerticalStackLayout Style="{StaticResource HistoryItemContentStyle}">

                                    <!-- Date and time -->
                                    <Label
                                        Text="{Binding DisplayDateTime, StringFormat='{0:dd-MM-yyyy HH:mm}'}"
                                        Style="{StaticResource HistoryDateStyle}"
                                        IsVisible="{Binding IsNotEditing}" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        Style="{StaticResource HistoryColumnsStyle}"
                                        IsVisible="{Binding IsEditing}">

                                        <DatePicker
                                            Grid.Column="0"
                                            Date="{Binding MeasuredDate}" />

                                        <TimePicker
                                            Grid.Column="1"
                                            Time="{Binding MeasuredTime}" />
                                    </Grid>

                                    <!-- Measurement values -->
                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        Style="{StaticResource HistoryColumnsStyle}">

                                        <!-- Systolic -->
                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Style="{StaticResource HistoryFieldStyle}">

                                            <Label
                                                Text="{x:Static localization:AppResources.Systolic}"
                                                Style="{StaticResource MeasurementCaptionStyle}" />

                                            <Label
                                                Text="{Binding BloodPressureMeasurement.Systolic}"
                                                Style="{StaticResource MeasurementValueStyle}"
                                                IsVisible="{Binding IsNotEditing}" />

                                            <Entry
                                                Text="{Binding SystolicInput}"
                                                Keyboard="Numeric"
                                                Style="{StaticResource MeasurementEntryStyle}"
                                                IsVisible="{Binding IsEditing}" />
                                        </VerticalStackLayout>

                                        <!-- Diastolic -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Style="{StaticResource HistoryFieldStyle}">

                                            <Label
                                                Text="{x:Static localization:AppResources.Diastolic}"
                                                Style="{StaticResource MeasurementCaptionStyle}" />

                                            <Label
                                                Text="{Binding BloodPressureMeasurement.Diastolic}"
                                                Style="{StaticResource MeasurementValueStyle}"
                                                IsVisible="{Binding IsNotEditing}" />

                                            <Entry
                                                Text="{Binding DiastolicInput}"
                                                Keyboard="Numeric"
                                                Style="{StaticResource MeasurementEntryStyle}"
                                                IsVisible="{Binding IsEditing}" />
                                        </VerticalStackLayout>

                                        <!-- Pulse -->
                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            Style="{StaticResource HistoryFieldStyle}">

                                            <Label
                                                Text="{x:Static localization:AppResources.Pulse}"
                                                Style="{StaticResource MeasurementCaptionStyle}" />

                                            <Label
                                                Text="{Binding PulseDisplay}"
                                                Style="{StaticResource MeasurementValueStyle}"
                                                IsVisible="{Binding IsNotEditing}" />

                                            <Entry
                                                Text="{Binding PulseInput}"
                                                Keyboard="Numeric"
                                                Style="{StaticResource MeasurementEntryStyle}"
                                                IsVisible="{Binding IsEditing}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Notes -->
                                    <VerticalStackLayout Style="{StaticResource HistoryFieldStyle}">
                                        <Label
                                            Text="{x:Static localization:AppResources.Notes}"
                                            Style="{StaticResource NotesCaptionStyle}" />

                                        <Label
                                            Text="{Binding NotesDisplay}"
                                            Style="{StaticResource NotesValueStyle}"
                                            IsVisible="{Binding IsNotEditing}" />

                                        <Entry
                                            Text="{Binding NotesInput}"
                                            IsVisible="{Binding IsEditing}" />
                                    </VerticalStackLayout>

                                    <!-- Actions -->
                                    <HorizontalStackLayout
                                        Style="{StaticResource HistoryActionsStyle}"
                                        IsVisible="{Binding IsNotEditing}">

                                        <Button
                                            Text="{x:Static localization:AppResources.Edit}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="{x:Static localization:AppResources.Delete}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                            CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout
                                        Style="{StaticResource HistoryActionsStyle}"
                                        IsVisible="{Binding IsEditing}">

                                        <Button
                                            Text="{x:Static localization:AppResources.Save}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SaveEditCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="{x:Static localization:AppResources.Cancel}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelEditCommand}"
                                            CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Navigate between history pages. -->
                <Grid ColumnDefinitions="*,Auto,*" Style="{StaticResource HistoryColumnsStyle}">
                    <Button Grid.Column="0" Text="{x:Static localization:AppResources.PreviousPage}" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" />
                    <Label Grid.Column="1" Text="{Binding PageText}" Style="{StaticResource CenteredLabelStyle}" />
                    <Button Grid.Column="2" Text="{x:Static localization:AppResources.NextPage}" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlays for adding a measurement and choosing export options. -->
        <views:NewBloodPressureMeasurementView IsVisible="{Binding IsAddingBloodPressureMeasurement}" />
        <views:ExportOptionsView IsVisible="{Binding IsExporting}" />
    </Grid>
</ContentPage>
