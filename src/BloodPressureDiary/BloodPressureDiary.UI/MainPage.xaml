<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:BloodPressureDiary.UI.Resources.Localization"
             xmlns:viewModels="clr-namespace:BloodPressureDiary.UI.ViewModels"
             xmlns:behaviors="clr-namespace:Kmaraszkiewicz86.Maui.Behaviors;assembly=Kmaraszkiewicz86.Maui.Behaviors"
             x:Class="BloodPressureDiary.UI.MainPage"
             Title="{x:Static localization:AppResources.BloodPressureMeasurementsTab}">
    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="{x:Static localization:AppResources.NewBloodPressureMeasurement}" FontSize="22" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Systolic}" />
                    <Entry Text="{Binding SystolicInput}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Diastolic}" />
                    <Entry Text="{Binding DiastolicInput}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Pulse}" />
                    <Entry Text="{Binding PulseInput}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Date}" />
                    <DatePicker Date="{Binding MeasuredDate}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Time}" />
                    <TimePicker Time="{Binding MeasuredTime}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static localization:AppResources.Notes}" />
                    <Entry Text="{Binding NotesInput}" />
                </VerticalStackLayout>
            </Grid>
            <Button Text="{x:Static localization:AppResources.Save}" Command="{Binding SaveCommand}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="{x:Static localization:AppResources.ExportBackup}" Command="{Binding ExportBackupCommand}" />
                <Button Grid.Column="1" Text="{x:Static localization:AppResources.ExportReport}" Command="{Binding ExportReportCommand}" />
            </Grid>

            <Label Text="{x:Static localization:AppResources.BloodPressureMeasurements}" FontSize="22" FontAttributes="Bold" />
            <Label Text="{x:Static localization:AppResources.NoBloodPressureMeasurements}" IsVisible="{Binding IsEmpty}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <VerticalStackLayout WidthRequest="1170" Spacing="4">
                    <Grid ColumnDefinitions="220,100,100,100,250,190,210" Padding="8" BackgroundColor="#E7ECF2">
                        <Label Grid.Column="0" Text="{x:Static localization:AppResources.DateAndTime}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{x:Static localization:AppResources.Systolic}" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="{x:Static localization:AppResources.Diastolic}" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="{x:Static localization:AppResources.Pulse}" FontAttributes="Bold" />
                        <Label Grid.Column="4" Text="{x:Static localization:AppResources.Notes}" FontAttributes="Bold" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding BloodPressureMeasurements}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BloodPressureMeasurementRowViewModel">
                                <Border Stroke="#D6DCE4" StrokeThickness="1" Padding="6">
                                    <Grid ColumnDefinitions="220,100,100,100,250,190,210" ColumnSpacing="4">
                                        <Label Grid.Column="0" Text="{Binding DisplayDateTime}" VerticalOptions="Center" IsVisible="{Binding IsNotEditing}" />
                                        <HorizontalStackLayout Grid.Column="0" Spacing="2" IsVisible="{Binding IsEditing}">
                                            <DatePicker Date="{Binding MeasuredDate}" WidthRequest="130" />
                                            <TimePicker Time="{Binding MeasuredTime}" WidthRequest="85" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding BloodPressureMeasurement.Systolic}" VerticalOptions="Center" HorizontalTextAlignment="Center" IsVisible="{Binding IsNotEditing}" />
                                        <Entry Grid.Column="1" Text="{Binding SystolicInput}" Keyboard="Numeric" IsVisible="{Binding IsEditing}" />
                                        <Label Grid.Column="2" Text="{Binding BloodPressureMeasurement.Diastolic}" VerticalOptions="Center" HorizontalTextAlignment="Center" IsVisible="{Binding IsNotEditing}" />
                                        <Entry Grid.Column="2" Text="{Binding DiastolicInput}" Keyboard="Numeric" IsVisible="{Binding IsEditing}" />
                                        <Label Grid.Column="3" Text="{Binding PulseDisplay}" VerticalOptions="Center" HorizontalTextAlignment="Center" IsVisible="{Binding IsNotEditing}" />
                                        <Entry Grid.Column="3" Text="{Binding PulseInput}" Keyboard="Numeric" IsVisible="{Binding IsEditing}" />
                                        <Label Grid.Column="4" Text="{Binding NotesDisplay}" VerticalOptions="Center" LineBreakMode="TailTruncation" IsVisible="{Binding IsNotEditing}" />
                                        <Entry Grid.Column="4" Text="{Binding NotesInput}" IsVisible="{Binding IsEditing}" />
                                        <HorizontalStackLayout Grid.Column="5" Spacing="6" VerticalOptions="Center" IsVisible="{Binding IsNotEditing}">
                                            <Button Text="{x:Static localization:AppResources.Edit}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" />
                                            <Button Text="{x:Static localization:AppResources.Delete}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="6" Spacing="6" VerticalOptions="Center" IsVisible="{Binding IsEditing}">
                                            <Button Text="{x:Static localization:AppResources.Save}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SaveEditCommand}" CommandParameter="{Binding .}" />
                                            <Button Text="{x:Static localization:AppResources.Cancel}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelEditCommand}" CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
