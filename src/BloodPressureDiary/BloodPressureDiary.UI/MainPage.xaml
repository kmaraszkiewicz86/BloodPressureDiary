<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:loc="clr-namespace:BloodPressureDiary.UI.Resources.Localization" x:Class="BloodPressureDiary.UI.MainPage" x:Name="DiaryPage" Title="{x:Static loc:AppResources.Measurements}">
 <Grid Padding="12" RowDefinitions="Auto,*" RowSpacing="8">
  <Button Text="{x:Static loc:AppResources.Settings}" Command="{Binding SettingsCommand}" />
  <ScrollView Grid.Row="1" Orientation="Both">
   <VerticalStackLayout WidthRequest="1250" Spacing="8" IsEnabled="{Binding IsAvailable}">
    <Grid ColumnDefinitions="140,110,150,150,140,240,320">
     <Label Grid.Column="0" Text="{x:Static loc:AppResources.Date}" FontAttributes="Bold" /><Label Grid.Column="1" Text="{x:Static loc:AppResources.Time}" FontAttributes="Bold" /><Label Grid.Column="2" Text="{x:Static loc:AppResources.Systolic}" FontAttributes="Bold" /><Label Grid.Column="3" Text="{x:Static loc:AppResources.Diastolic}" FontAttributes="Bold" /><Label Grid.Column="4" Text="{x:Static loc:AppResources.Pulse}" FontAttributes="Bold" /><Label Grid.Column="5" Text="{x:Static loc:AppResources.Note}" FontAttributes="Bold" />
     <Label Grid.Column="6" Text="{x:Static loc:AppResources.Actions}" />
    </Grid>
    <Grid ColumnDefinitions="140,110,150,150,140,240,320" BindingContext="{Binding NewMeasurement}">
     <DatePicker Grid.Column="0" Date="{Binding Date, Mode=TwoWay}" SemanticProperties.Description="{x:Static loc:AppResources.Date}" />
<TimePicker Grid.Column="1" Time="{Binding Time, Mode=TwoWay}" SemanticProperties.Description="{x:Static loc:AppResources.Time}" />
<Entry Grid.Column="2" Text="{Binding Systolic, Mode=TwoWay}" Placeholder="{x:Static loc:AppResources.Systolic}" Keyboard="Numeric" SemanticProperties.Description="{x:Static loc:AppResources.Systolic}" />
<Entry Grid.Column="3" Text="{Binding Diastolic, Mode=TwoWay}" Placeholder="{x:Static loc:AppResources.Diastolic}" Keyboard="Numeric" SemanticProperties.Description="{x:Static loc:AppResources.Diastolic}" />
<Entry Grid.Column="4" Text="{Binding Pulse, Mode=TwoWay}" Placeholder="{x:Static loc:AppResources.Pulse}" Keyboard="Numeric" SemanticProperties.Description="{x:Static loc:AppResources.Pulse}" />
<Entry Grid.Column="5" Text="{Binding Note, Mode=TwoWay}" Placeholder="{x:Static loc:AppResources.Note}" MaxLength="1000" SemanticProperties.Description="{x:Static loc:AppResources.Note}" />

     <Button Grid.Column="6" Text="{x:Static loc:AppResources.Save}" Command="{Binding BindingContext.SaveCommand, Source={x:Reference DiaryPage}}" />
    </Grid>
    <BoxView HeightRequest="1" Color="Gray" />
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="1">
     <BindableLayout.EmptyView><Label Text="{x:Static loc:AppResources.Empty}" /></BindableLayout.EmptyView>
     <BindableLayout.ItemTemplate>
      <DataTemplate>
       <Border Stroke="Gray" Padding="2">
        <Grid ColumnDefinitions="140,110,150,150,140,240,320">
         <DatePicker Grid.Column="0" Date="{Binding Date, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" SemanticProperties.Description="{x:Static loc:AppResources.Date}" />
<TimePicker Grid.Column="1" Time="{Binding Time, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" SemanticProperties.Description="{x:Static loc:AppResources.Time}" />
<Entry Grid.Column="2" Text="{Binding Systolic, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Placeholder="{x:Static loc:AppResources.Systolic}" Keyboard="Numeric" SemanticProperties.Description="{x:Static loc:AppResources.Systolic}" />
<Entry Grid.Column="3" Text="{Binding Diastolic, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Placeholder="{x:Static loc:AppResources.Diastolic}" Keyboard="Numeric" SemanticProperties.Description="{x:Static loc:AppResources.Diastolic}" />
<Entry Grid.Column="4" Text="{Binding Pulse, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Placeholder="{x:Static loc:AppResources.Pulse}" Keyboard="Numeric" SemanticProperties.Description="{x:Static loc:AppResources.Pulse}" />
<Entry Grid.Column="5" Text="{Binding Note, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Placeholder="{x:Static loc:AppResources.Note}" MaxLength="1000" SemanticProperties.Description="{x:Static loc:AppResources.Note}" />

         <HorizontalStackLayout Grid.Column="6" Spacing="4">
          <Button Text="{x:Static loc:AppResources.Edit}" IsVisible="{Binding IsReadOnly}" Command="{Binding BindingContext.EditCommand, Source={x:Reference DiaryPage}}" CommandParameter="{Binding .}" /><Button Text="{x:Static loc:AppResources.Delete}" IsVisible="{Binding IsReadOnly}" Command="{Binding BindingContext.DeleteCommand, Source={x:Reference DiaryPage}}" CommandParameter="{Binding .}" /><Button Text="{x:Static loc:AppResources.Save}" IsVisible="{Binding IsEditing}" Command="{Binding BindingContext.SaveRowCommand, Source={x:Reference DiaryPage}}" CommandParameter="{Binding .}" /><Button Text="{x:Static loc:AppResources.Cancel}" IsVisible="{Binding IsEditing}" Command="{Binding BindingContext.CancelCommand, Source={x:Reference DiaryPage}}" CommandParameter="{Binding .}" />
         </HorizontalStackLayout>
        </Grid>
       </Border>
      </DataTemplate>
     </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
   </VerticalStackLayout>
  </ScrollView>
 </Grid>
</ContentPage>
