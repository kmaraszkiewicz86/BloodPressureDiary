<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:BloodPressureDiary.UI.Resources.Localization"
             x:Class="BloodPressureDiary.UI.Views.ExportOptionsView">
    <Grid BackgroundColor="#80000000" Padding="16">
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}"
                Stroke="{AppThemeBinding Light=#D6DCE4, Dark=#6E6E6E}"
                VerticalOptions="Center">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="14">
                    <Label Text="{Binding ExportWindowTitle}" FontSize="22" FontAttributes="Bold" />
                    <Picker Title="{x:Static localization:AppResources.ExportPeriod}"
                            ItemsSource="{Binding HistoryFilters}"
                            SelectedIndex="{Binding SelectedExportFilter}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static localization:AppResources.UseDateRange}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding UseExportDateRange}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding UseExportDateRange}">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{x:Static localization:AppResources.StartDate}" />
                            <DatePicker Date="{Binding ExportStartDate}" MaximumDate="{Binding Today}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{x:Static localization:AppResources.EndDate}" />
                            <DatePicker Date="{Binding ExportEndDate}" MaximumDate="{Binding Today}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="{x:Static localization:AppResources.CreateFile}" Command="{Binding ConfirmExportCommand}" />
                        <Button Grid.Column="1" Text="{x:Static localization:AppResources.Cancel}" Command="{Binding CancelExportCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
